<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\eng\Compatibility.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Wandelbots.Nova.Api</PackageId>
    <Description>Generated .NET client for the Wandelbots NOVA REST API.</Description>
    <PackageTags>wandelbots;nova;robotics;openapi</PackageTags>
    <RepositoryUrl>https://github.com/ardo314/wandelbots-nova-dotnet</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>ardo314 contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReleaseNotes>Supports NOVA $(NovaProductVersion); generated from OpenAPI $(OpenApiVersion). See docs/versioning.md in the repository for the versioning policy.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="NovaProductVersion" Value="$(NovaProductVersion)" />
    <AssemblyMetadata Include="OpenApiVersion" Value="$(OpenApiVersion)" />
  </ItemGroup>

</Project>
